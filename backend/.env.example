PORT=5000
NODE_ENV=development

# MySQL (change user, password and database name)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/saas_db"

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend (the code uses both names, so set both)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Email / OTP (needed for registering with email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME="Lunar SaaS"

SMTP_FROM_NAME="Lunar SaaS"

# Google login (optional, can be left empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback